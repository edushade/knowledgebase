.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
logs/

